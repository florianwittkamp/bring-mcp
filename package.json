{
  "name": "bring-mcp",
  "version": "0.9.2-beta",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "test": "npm run format && eslint . --ext .ts --fix && NODE_OPTIONS=--experimental-vm-modules jest",
    "lint:ci": "prettier --check . && eslint . --ext .ts",
    "test:ci": "npm run lint:ci && NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "build": "tsc",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest",
    "clean": "rm -rf node_modules package-lock.json build",
    "rebuild": "npm run clean && npm install && npm run build",
    "format": "prettier --write ."
  },
  "keywords": [
    "modelcontextprotocol",
    "bring",
    "shopping",
    "mcp"
  ],
  "author": "florianwittkamp",
  "license": "MIT",
  "description": "MCP Server for Bring! Shopping",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florianwittkamp/bring-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "bring-mcp": "build/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "bring-shopping": "^2.0.1",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.6",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
