# Pflichtfelder: Werte zwischen die einfachen Anfuehrungszeichen eintragen.
# Einfache Anfuehrungszeichen erhalten Sonderzeichen wie $ und # unveraendert.
BRING_EMAIL=''
BRING_PASSWORD=''

# OpenAI Secure MCP Tunnel: ID und Runtime-API-Key aus den Platform-Einstellungen.
# https://platform.openai.com/settings/organization/tunnels
# Der Runtime-Key benoetigt Tunnels Read + Use; keinen Admin-Key verwenden.
CONTROL_PLANE_TUNNEL_ID=''
CONTROL_PLANE_API_KEY=''

# Optional: lokale Tunnel-Statusseite auf http://localhost:8090/ui
TUNNEL_UI_PORT=8090
LOG_LEVEL=info
