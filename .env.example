# Bring! account credentials (required)
MAIL=your_email@example.com
PW=your_password

# HTTP server port (optional, default: 3000)
PORT=3000

# Bearer token / API key to protect the MCP endpoint (optional but recommended)
# Clients must send:  Authorization: Bearer <value>  OR  x-api-key: <value>
MCP_API_KEY=change-me-to-a-strong-random-secret

# Allowed CORS origin (optional, default: * — open to all origins)
# Set to your Claude.ai origin to restrict access, e.g.: https://claude.ai
CORS_ORIGIN=*
