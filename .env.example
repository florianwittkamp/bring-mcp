MAIL=your_email@example.com
PW=your_password

# HTTP / Remote mode (optional)
PORT=3000

# Scalekit OAuth 2.1 Authentication (recommended for remote/production HTTP deployments)
# 1. Sign up at https://www.scalekit.com or auth.scalekit.com
# 2. Create/register your MCP server in Scalekit dashboard (set Server URL to your base URL e.g. https://your-app.com/ )
# 3. Copy the OAuth Protected Resource Metadata JSON and paste below (as single line or escaped)
# 4. Copy Client ID, Secret, Environment URL from Scalekit
SK_ENV_URL=https://<your-env>.scalekit.com
SK_CLIENT_ID=your-scalekit-client-id
SK_CLIENT_SECRET=your-scalekit-client-secret
PROTECTED_RESOURCE_METADATA='{"resource":"https://your-app.com/","authorization_servers":["https://<your-env>.scalekit.com"]}'  # Paste full JSON from Scalekit here
EXPECTED_AUDIENCE=https://your-app.com/   # Usually matches the resource or base URL you registered
MCP_SERVER_ID=optional-mcp-server-id-from-scalekit
